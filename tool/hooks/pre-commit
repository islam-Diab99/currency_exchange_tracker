#!/bin/sh
# Simple pre-commit hook: format check + static analysis.
# Install: cp tool/hooks/pre-commit .git/hooks/ && chmod +x .git/hooks/pre-commit

echo "Running pre-commit checks..."

# 1. Fail if any Dart file is not formatted.
if ! dart format --output=none --set-exit-if-changed lib test; then
  echo "❌ Code is not formatted. Run: dart format lib test"
  exit 1
fi

# 2. Fail on analyzer errors.
if ! flutter analyze; then
  echo "❌ Analyzer found issues. Fix them before committing."
  exit 1
fi

echo "✅ All checks passed."
exit 0
